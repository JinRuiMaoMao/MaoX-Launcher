<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MaoX.Controls"
             x:Class="MaoX.MainView"
             Background="{StaticResource Bg}">
  <Panel>
    <!-- 全窗口背景图 + 遮罩 -->
    <Border Name="BackdropImage" IsVisible="False" IsHitTestVisible="False" />
    <Border Name="BackdropMask" IsVisible="False" IsHitTestVisible="False" Background="{StaticResource BackdropMaskBg}" />

    <Grid Name="Shell" ColumnDefinitions="236,*">
      <!-- 侧边栏 -->
      <Border Name="SidebarPanel" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource CardBorder}"
              BorderThickness="0,0,1,0">
        <DockPanel Name="SidebarDock" Margin="14,0,14,16">
          <StackPanel Name="Brand" DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,52,0,34">
            <c:Logo Name="BrandLogo" Width="36" Height="44" Margin="0,-6,0,0" />
            <StackPanel Name="BrandText" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="MaoX" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="LAUNCHER" Classes="overline" FontSize="10" LetterSpacing="3.2" />
            </StackPanel>
          </StackPanel>

          <TextBlock Name="VersionText" DockPanel.Dock="Bottom" Classes="small dim" Margin="12,10,0,0" />
          <Button Name="AccountCard" DockPanel.Dock="Bottom" Padding="12" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Background="{StaticResource AccountCardBg}" CornerRadius="12"
                  Click="OnAccountCardClick">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <c:Avatar Name="SidebarAvatar" Width="38" Height="38" />
              <StackPanel Name="AccountText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Name="SidebarAccountName" FontWeight="SemiBold" />
                <TextBlock Name="SidebarAccountType" Classes="small muted" FontWeight="Normal" />
              </StackPanel>
              <c:Icon Name="AccountChevron" Grid.Column="2" Kind="chevron-right" Size="16" Foreground="{StaticResource Dim}" />
            </Grid>
          </Button>

          <c:PawTrail Name="SidebarPaws" DockPanel.Dock="Bottom" Width="180" Height="190" HorizontalAlignment="Center"
                      Margin="0,0,0,14" Opacity="0.08" IsHitTestVisible="False" Foreground="{StaticResource Text}" />

          <ScrollViewer Name="NavScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="Nav" Spacing="4">
            <RadioButton Classes="nav" GroupName="nav" Tag="launch" Click="OnNavClick">
              <c:IconLabel Icon="play" Text="{c:Tr 启动}" Spacing="14" HorizontalAlignment="Left" />
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" Tag="download" Click="OnNavClick">
              <c:IconLabel Icon="download" Text="{c:Tr 下载}" Spacing="14" HorizontalAlignment="Left" />
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" Tag="resources" Click="OnNavClick">
              <c:IconLabel Icon="box" Text="{c:Tr 资源}" Spacing="14" HorizontalAlignment="Left" />
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" Tag="multiplayer" Click="OnNavClick">
              <c:IconLabel Icon="people" Text="{c:Tr 联机}" Spacing="14" HorizontalAlignment="Left" />
            </RadioButton>
            <RadioButton Classes="nav" GroupName="nav" Tag="settings" Click="OnNavClick">
              <c:IconLabel Icon="settings" Text="{c:Tr 设置}" Spacing="14" HorizontalAlignment="Left" />
            </RadioButton>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 内容区 -->
      <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <!-- 屏幕太矮（手机横屏）时页面按最小高度排版，可以上下滑动 -->
        <ScrollViewer Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <TransitioningContentControl Name="PageHost" Margin="36,46,36,8">
          <TransitioningContentControl.PageTransition>
            <CompositePageTransition>
              <CrossFade Duration="0:0:0.18" />
              <PageSlide Duration="0:0:0.22" Orientation="Vertical" SlideInEasing="CubicEaseOut"
                         SlideOutEasing="CubicEaseIn" />
            </CompositePageTransition>
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
        </ScrollViewer>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
          <c:ProgressLine Name="ProgressBar" Height="2" />
          <Grid Name="StatusBar" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="36,4,30,8">
            <TextBlock Name="StatusText" Classes="small muted" Text="{c:Tr 就绪}" VerticalAlignment="Center" />
            <TextBlock Name="ProgressText" Grid.Column="1" Classes="small muted" VerticalAlignment="Center" />
            <Button Name="TasksButton" Grid.Column="2" Classes="ghost small" Margin="10,0,0,0" MinHeight="26"
                    IsVisible="False" Click="OnTasksButtonClick">
              <c:IconLabel Name="TasksLabel" Icon="layers" IconSize="14" Spacing="6" Text="{c:Tr 任务}" />
            </Button>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- 提示气泡 -->
    <StackPanel Name="ToastLayer" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,52"
                Spacing="10" />

    <!-- 窗口内对话框 -->
    <Panel Name="DialogLayer" IsVisible="False">
      <Border Name="DialogBackdrop" Background="{StaticResource Overlay}" Opacity="0">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
          </Transitions>
        </Border.Transitions>
      </Border>
      <Panel Name="DialogStack" />
    </Panel>
  </Panel>
</UserControl>
