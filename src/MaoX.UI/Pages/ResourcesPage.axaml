<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MaoX.Controls"
             x:Class="MaoX.Pages.ResourcesPage">
  <DockPanel>
    <StackPanel Name="PageTitle" DockPanel.Dock="Top" Classes="pagehead" Spacing="2">
      <TextBlock Text="{c:Tr 资源}" Classes="h1" />
      <TextBlock Text="{c:Tr 模组、资源包、光影、数据包和整合包}" Classes="muted pagesub" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <StackPanel Name="KindChips" Orientation="Horizontal" Spacing="8" />
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock Name="InfoLoader" Classes="accent bold" />
          <TextBlock Name="InfoRest" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <StackPanel Name="WorldColumn" Orientation="Horizontal" Spacing="8" IsVisible="False"
                    VerticalAlignment="Center">
          <TextBlock Text="{c:Tr 目标存档}" Classes="label" VerticalAlignment="Center" />
          <ComboBox Name="WorldBox" Width="170" SelectionChanged="OnWorldChanged" />
        </StackPanel>
        <StackPanel Name="VersionColumn" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{c:Tr 目标版本}" Classes="label" VerticalAlignment="Center" />
          <ComboBox Name="VersionBox" Width="220" SelectionChanged="OnVersionChanged"
                    PlaceholderText="{c:Tr 未安装任何版本}" />
        </StackPanel>
        <Button Click="OnImportModpack">
          <c:IconLabel Icon="archive" Text="{c:Tr 导入整合包文件}" />
        </Button>
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <Panel HorizontalAlignment="Left" VerticalAlignment="Center">
        <Border Name="TabPill" Classes="tabpill" Opacity="0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ToggleButton Name="ModrinthTab" Classes="chip tab" Content="Modrinth" Tag="modrinth" Click="OnTabClick" />
          <ToggleButton Name="CurseForgeTab" Classes="chip tab" Content="CurseForge" Tag="curseforge" Click="OnTabClick" />
          <ToggleButton Name="LocalTab" Classes="chip tab" Content="{c:Tr 已安装}" Tag="local" Click="OnTabClick" />
          <ToggleButton Name="FavTab" Classes="chip tab" Content="{c:Tr 收藏}" Tag="favorites" Click="OnTabClick" />
        </StackPanel>
      </Panel>
      <StackPanel Name="BrowseTools" Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <ComboBox Name="SortBox" Width="150" SelectionChanged="OnSortChanged" />
        <TextBox Name="SearchBox" Width="230" Watermark="{c:Tr 搜索}">
          <TextBox.InnerLeftContent>
            <c:Icon Kind="search" Size="16" Margin="10,0,0,0" Foreground="{StaticResource Dim}" />
          </TextBox.InnerLeftContent>
        </TextBox>
      </StackPanel>
      <StackPanel Name="LocalTools" Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="False">
        <Button Name="UpdateAllButton" Classes="primary" IsVisible="False" Click="OnUpdateAll">
          <c:IconLabel Name="UpdateAllLabel" Icon="download" Text="{c:Tr 全部更新}" />
        </Button>
        <Button Name="CheckUpdateButton" Click="OnCheckUpdates">
          <c:IconLabel Name="CheckUpdateLabel" Icon="refresh" Text="{c:Tr 检查更新}" />
        </Button>
        <Button Click="OnOpenFolder">
          <c:IconLabel Icon="folder" Text="{c:Tr 打开文件夹}" />
        </Button>
        <Button Classes="icon" ToolTip.Tip="{c:Tr 刷新}" Click="OnRefreshLocal">
          <c:Icon Kind="refresh" Size="17" />
        </Button>
      </StackPanel>
    </Grid>

    <Panel>
      <ScrollViewer Name="BrowseView" Padding="0,0,12,0">
        <StackPanel Name="BrowseList" Spacing="10" />
      </ScrollViewer>
      <ScrollViewer Name="LocalView" Padding="0,0,12,0" IsVisible="False">
        <StackPanel Name="LocalList" Spacing="8" />
      </ScrollViewer>
      <StackPanel Name="EmptyView" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="0,0,0,60" Spacing="6">
        <c:Icon Kind="paw" Filled="True" Size="50" StrokeWidth="0" Foreground="{StaticResource Dim}" />
        <TextBlock Name="EmptyTitle" Classes="h3" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <TextBlock Name="EmptyText" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" LineHeight="22" />
        <Button Name="EmptyButton" Classes="primary" HorizontalAlignment="Center" Margin="0,14,0,0"
                Click="OnGoDownload">
          <c:IconLabel Icon="download" Text="{c:Tr 前往下载页}" />
        </Button>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
