<Project>
  <PropertyGroup>
    <!-- 启动器版本号：发布时打 tag v<版本号>，GitHub Actions 会检查两者一致。
         热修复用 2.2.0-HotFix.N；从 2.2.0-HotFix.1 起的更新器会比较这个后缀。 -->
    <Version>2.2.0-HotFix.2</Version>
    <VersionCore Condition="$(Version.Contains('-'))">$(Version.Substring(0, $(Version.IndexOf('-'))))</VersionCore>
    <VersionCore Condition="'$(VersionCore)' == ''">$(Version)</VersionCore>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
