<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>MaoX JIT Helper</string>
  <key>CFBundleExecutable</key>
  <string>MaoXJITHelper</string>
  <key>CFBundleIdentifier</key>
  <string>@APP_ID@.JITHelper</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MaoXJITHelper</string>
  <key>CFBundlePackageType</key>
  <string>XPC!</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleSupportedPlatforms</key>
  <array>
    <string>iPhoneOS</string>
  </array>
  <key>MinimumOSVersion</key>
  <string>17.4</string>
  <key>UIDeviceFamily</key>
  <array>
    <integer>1</integer>
    <integer>2</integer>
  </array>
  <!-- Started only by the launcher through NSExtension; FALSEPREDICATE keeps it out of every share / preview UI -->
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionAttributes</key>
    <dict>
      <key>NSExtensionActivationRule</key>
      <string>FALSEPREDICATE</string>
    </dict>
    <key>NSExtensionContextClass</key>
    <string>NSExtensionContext</string>
    <key>NSExtensionContextHostClass</key>
    <string>NSExtensionContext</string>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.ar.viewer</string>
    <key>NSExtensionPrincipalClass</key>
    <string>MaoXJITHelperHandler</string>
  </dict>
  <key>XPCService</key>
  <dict>
    <key>ServiceType</key>
    <string>Application</string>
    <key>_MultipleInstances</key>
    <true/>
    <key>_ProcessType</key>
    <string>App</string>
  </dict>
</dict>
</plist>
