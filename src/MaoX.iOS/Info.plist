<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>MaoX Launcher</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UIDeviceFamily</key>
  <array>
    <integer>1</integer>
    <integer>2</integer>
  </array>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
  </array>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UIStatusBarHidden</key>
  <true/>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!-- iPad 上可以分屏、竖屏，界面会自动切换成紧凑布局 -->
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!-- 游戏文件放在“文稿”里，允许在“文件”App 中查看和导入模组、存档 -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- 启动页检测、打开基岩版 -->
  <key>LSApplicationQueriesSchemes</key>
  <array>
    <string>minecraft</string>
    <string>sidestore</string>
    <string>altstore</string>
    <string>apple-magnifier</string>
  </array>
  <!-- 陶瓦联机和同一局域网里的好友直连；内置 JIT 在本机生成配对文件时广播“可配对的电脑” -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>陶瓦联机需要访问局域网，才能和同一网络里的好友直接连接；在本机生成配对文件时也需要访问本地网络。</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_remotepairing-pairable-host._tcp</string>
  </array>
  <!-- 在本机生成配对文件时，用户去“设置”里配对期间启动器要继续运行；侧载工具可能改包名，所以用通配符 -->
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array>
    <string>io.github.jinruimaomao.maox.*</string>
  </array>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
  <key>XSAppIconAssets</key>
  <string>Assets.xcassets/AppIcon.appiconset</string>
</dict>
</plist>
