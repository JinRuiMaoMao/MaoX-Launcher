<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- 启动器自动更新：下载新版 APK 后交给系统安装 -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- 游戏里的 JVM 按文件路径加载原生库，所以要解压到 nativeLibraryDir -->
  <application android:label="MaoX Launcher" android:icon="@drawable/icon" android:extractNativeLibs="true"
               android:allowNativeHeapPointerTagging="false" android:largeHeap="true" android:usesCleartextTraffic="true">
    <!-- JVM 退出时会结束整个进程，所以游戏放在单独的纯 Java 进程里，不加载 .NET -->
    <activity android:name="io.github.jinruimaomao.maox.GameActivity" android:process=":game" android:exported="false"
              android:theme="@style/MaoX.Theme" android:screenOrientation="sensorLandscape"
              android:configChanges="keyboard|keyboardHidden|navigation|orientation|smallestScreenSize|screenLayout|screenSize|uiMode|density" />
    <!-- 陶瓦联机的虚拟网卡 -->
    <service android:name="io.github.jinruimaomao.maox.TerracottaVpnService" android:exported="false"
             android:permission="android.permission.BIND_VPN_SERVICE">
      <intent-filter>
        <action android:name="android.net.VpnService" />
      </intent-filter>
    </service>
  </application>
</manifest>
