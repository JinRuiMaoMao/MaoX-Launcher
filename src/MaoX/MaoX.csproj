<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MaoX</RootNamespace>
    <AssemblyName>MaoXLauncher</AssemblyName>
    <Product>MaoX Launcher</Product>
    <ApplicationIcon>..\MaoX.UI\Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- NAudio 的 Media Foundation 解码 MP3 / FLAC / M4A 需要 COM。关掉后一播背景音乐启动器就会崩。 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaoX.UI\MaoX.UI.csproj" />
  </ItemGroup>

</Project>
