<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:MaoX.Controls"
             x:Class="MaoX.Pages.SettingsPage">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22" Spacing="2">
      <TextBlock Text="设置" Classes="h1" />
      <TextBlock Text="所有修改会自动保存" Classes="muted" />
    </StackPanel>

    <ScrollViewer Padding="0,0,14,0">
      <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,20,Auto,20,Auto,20,Auto" Margin="0,0,0,10">
        <!-- 游戏 -->
        <Border Classes="card" Padding="22,18,22,22">
          <StackPanel Spacing="18">
            <c:IconLabel Icon="game" Text="游戏" Classes="cardhead" />
            <StackPanel Spacing="8">
              <TextBlock Text="游戏目录" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Name="McDirBox" LostFocus="OnMcDirLostFocus" />
                <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Click="OnBrowseMcDir" />
                <Button Grid.Column="2" Classes="icon" Width="36" Margin="6,0,0,0" ToolTip.Tip="打开文件夹"
                        Click="OnOpenMcDir">
                  <c:Icon Kind="folder" Size="17" />
                </Button>
              </Grid>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="版本隔离" />
                <TextBlock Text="每个版本独立存档、模组和设置" Classes="small dim" />
              </StackPanel>
              <ToggleSwitch Name="IsolationSwitch" Grid.Column="1" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Java -->
        <Border Grid.Column="2" Classes="card" Padding="22,18,22,22">
          <StackPanel Spacing="18">
            <c:IconLabel Icon="java" Text="Java" Classes="cardhead" />
            <StackPanel Spacing="8">
              <TextBlock Text="Java 路径" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <ComboBox Name="JavaBox" HorizontalAlignment="Stretch" SelectionChanged="OnJavaChanged" />
                <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Click="OnBrowseJava" />
                <Button Grid.Column="2" Content="检测" Margin="8,0,0,0" Click="OnDetectJava" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="最大内存" />
                <TextBlock Name="RamText" Grid.Column="1" Classes="small dim" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Name="MemoryText" Grid.Column="2" Classes="accent bold" />
              </Grid>
              <Slider Name="MemorySlider" Minimum="512" TickFrequency="256" IsSnapToTickEnabled="True" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 下载 -->
        <Border Grid.Row="2" Classes="card" Padding="22,18,22,22">
          <StackPanel Spacing="18">
            <c:IconLabel Icon="cloud" Text="下载" Classes="cardhead" />
            <StackPanel Spacing="8">
              <TextBlock Text="下载源" />
              <ComboBox Name="SourceBox" HorizontalAlignment="Stretch" SelectionChanged="OnSourceChanged" />
            </StackPanel>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="下载线程数" />
                <TextBlock Name="ThreadsText" Grid.Column="1" Classes="accent bold" />
              </Grid>
              <Slider Name="ThreadsSlider" Minimum="1" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 高级 -->
        <Border Grid.Row="2" Grid.Column="2" Classes="card" Padding="22,18,22,22">
          <StackPanel Spacing="18">
            <c:IconLabel Icon="tune" Text="高级" Classes="cardhead" />
            <StackPanel Spacing="8">
              <TextBlock Text="游戏窗口大小" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox Name="WidthBox" Width="96" />
                <TextBlock Text="×" Classes="muted" VerticalAlignment="Center" />
                <TextBox Name="HeightBox" Width="96" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="额外 JVM 参数" />
                <TextBlock Text="以空格分隔" Classes="small dim" VerticalAlignment="Center" />
              </StackPanel>
              <TextBox Name="JvmBox" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 账号 -->
        <Border Grid.Row="4" Classes="card" Padding="22,18,22,22">
          <StackPanel Spacing="18">
            <c:IconLabel Icon="people" Text="账号" Classes="cardhead" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="账号管理" />
                <TextBlock Text="离线、外置登录与微软账号" Classes="small dim" />
              </StackPanel>
              <Button Grid.Column="1" Click="OnManageAccounts">
                <c:IconLabel Icon="user" Text="管理账号" />
              </Button>
            </Grid>
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="微软登录 Client ID" />
                <TextBlock Grid.Column="1" Text="在 Azure 注册的应用 ID" Classes="small dim" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="link" Content="如何获取？" Click="OnClientIdGuide" />
              </Grid>
              <TextBox Name="ClientIdBox" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 个性化 -->
        <Border Grid.Row="4" Grid.Column="2" Classes="card" Padding="22,18,22,22">
          <StackPanel Spacing="18">
            <c:IconLabel Icon="palette" Text="个性化" Classes="cardhead" />
            <StackPanel Spacing="8">
              <TextBlock Text="启动游戏后" />
              <ComboBox Name="AfterLaunchBox" HorizontalAlignment="Stretch" SelectionChanged="OnAfterLaunchChanged" />
            </StackPanel>
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="背景图片" />
                <TextBlock Text="铺满整个启动器，支持 PNG、JPG、WebP" Classes="small dim" VerticalAlignment="Center" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Name="BackgroundBox" Watermark="未设置" LostFocus="OnBackgroundLostFocus" />
                <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Click="OnBrowseBackground" />
                <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" Click="OnClearBackground" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="遮罩浓度" />
                <TextBlock Grid.Column="1" Text="越高背景越暗，文字越清楚" Classes="small dim" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Name="MaskText" Grid.Column="2" Classes="accent bold" />
              </Grid>
              <Slider Name="MaskSlider" Minimum="0" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 关于 -->
        <Border Grid.Row="6" Grid.ColumnSpan="3" Classes="card" Padding="22,18,22,18">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <c:Logo Width="40" Height="40" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3" VerticalAlignment="Center">
              <TextBlock Name="AboutVersion" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Name="AboutPlatform" Classes="small muted" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="自动检查更新" VerticalAlignment="Center" />
                <ToggleSwitch Name="AutoUpdateSwitch" OnContent="" OffContent="" MinWidth="0" />
              </StackPanel>
              <Button Click="OnOpenRepo">
                <c:IconLabel Icon="link" Text="GitHub" />
              </Button>
              <Button Name="CheckUpdateButton" Classes="primary" Click="OnCheckUpdate">
                <c:IconLabel Icon="refresh" Text="检查更新" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
